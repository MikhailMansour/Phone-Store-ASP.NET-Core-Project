@model List<ProductsViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_SallerLayout.cshtml";
    var index = 1;
}

<div class="container-fluid mx-0 px-5 bg-light py-1 ">
    
    <h3 class=" mb-5 fw-bold">
        <span class="bg-black text-white px-3 py-2 rounded">
            <i class="fas fa-boxes"></i> Products
        </span>
    </h3>

    <hr />
    <div class="row my-3 justify-content-center">
        <a asp-action="Add" asp-controller="Product" class="btn custom-signin-btn btn-dark w-25 fs-6 fw-bolder">Add New Product</a>
    </div>
    <table class="table table-bordered table-hover  my-5">
        <thead class="text-center bg-info text-white">
            <tr class="text-center">
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Image</th>
                <th scope="col">Brand</th>
                <th scope="col">Price</th>
                <th scope="col">Information</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var pro in Model)
            {
                <tr class="text-center">
                    <th scope="row">@index</th>
                    <td>@pro.Name</td>
                    <td><img src="/images/@pro.HeaderImage" width="100" height="100" class="rounded-circle" /></td>
                    <td>@pro.Brand</td>
                    <td>@pro.Price</td>
                    <td><a class="btn btn-warning" asp-action="Update" asp-route-id="@pro.Id" asp-controller="Product"><i class="fa-solid fa-eye"></i>See More</a></td>
                    <td><a class="btn btn-danger" asp-action="Delete" asp-route-id="@pro.Id" asp-controller="Product"><i class="fa-solid fa-trash"></i>Delete</a></td>
                </tr>
                index++;
            }
        </tbody>
    </table>
</div>
