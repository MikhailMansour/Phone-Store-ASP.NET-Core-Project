@model PaginationResult<ProductsViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<div class="row px-4">
    @foreach (var item in Model.Items)
    {
        <div class="col-md-3 p-3">
            <div class="card shadow-sm rounded-4 overflow-hidden border-0" style="height: 420px;">
                                       <a asp-action="Index" asp-controller="ProduectDetails" asp-route-productId="@item.Id" class="text-decoration-none text-muted">

                <img src="~/images/@item.HeaderImage" class="card-img-top" style="height: 200px; object-fit: cover;">
                </a>
                <div class="card-body text-center">
                                            <a asp-action="Index" asp-controller="ProduectDetails" asp-route-productId="@item.Id" class="text-decoration-none text-muted">

                    <h5 class="card-title text-capitalize mb-1">@item.Name</h5>
</a>
Smart Phone
                    @* <a asp-action="Index" asp-controller="ProduectDetails" asp-route-productId="@item.Id" class="text-decoration-none text-muted">
                        <p class="card-text small">@item.Description</p>
                    </a> *@
                    <p class="text-info fw-semibold">@item.Price EGP</p>

                    @if (item.IsBought)
                    {
                        <span class="text-danger fw-bold">Out Of Stock</span>
                    }
                    else
                    {
                        <a asp-action="Product" asp-controller="Product" asp-route-productId="@item.Id" class="btn custom-signin-btn btn-dark w-100">Buy Now</a>
                    }
                </div>
            </div>
        </div>
    }
</div>


