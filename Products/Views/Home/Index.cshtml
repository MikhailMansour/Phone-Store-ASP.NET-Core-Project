@model PaginationResult<ProductsViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}
<style>
    .scroll-button {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        opacity: 0.8;
        transition: opacity 0.3s ease;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
    }

    /* Left arrow */
    .scroll-left {
        left: 10px;
    }

    /* Right arrow */
    .scroll-right {
        right: 10px;
    }

    .product-slider {
        display: flex;
        overflow-x: auto;
        gap: 1rem;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        padding: 1rem 0;
    }

        .product-slider::-webkit-scrollbar {
            display: none;
        }

    .product-card {
        flex: 0 0 auto;
        width: 250px;
        scroll-snap-align: start;
        transition: transform 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

</style>

<main role="main" class="container my-5">

    <!-- ✅ Hero Slider -->
    <div id="mainCarousel" class="carousel slide mb-5 shadow-lg rounded-4 overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/slider/slider1.png" class="d-block w-100" style="height: 400px; object-fit: cover;" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="/images/slider/slider2.png" class="d-block w-100" style="height: 400px; object-fit: cover;" alt="Slide 2">
            </div>

        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" style="background-color:black;"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" style="background-color:black;"></span>
        </button>
    </div>
    <br />
    <br />

    <br />
    <br />
    <!-- ✅ ترحيب -->
    <div class="text-center mb-5">
        @* <h2 class="fw-bold text-dark">Welcome to Mobile Phones Store</h2> *@
        <h2 class="text-center mb-5 fw-bold">
            <span class="bg-black text-white px-3 py-2 rounded">
                Welcome to Mobile Phones Store
            </span>
        </h2>
        <p class="text-muted">Discover the best smartphones with top deals, guaranteed quality, and fast delivery.</p>
    </div>
    <div class="text-center mb-5">
        @* <h2 class="fw-bold text-dark">Welcome to Mobile Phones Store</h2> *@
        <h2 class="text-center mb-5 fw-bold">
            <span class="bg-black text-white px-3 py-2 rounded">
                Our Produects
            </span>
        </h2>

    </div>
    <br />
    <br />
    <div class="position-relative my-5">

        <!-- ✅ زر السهم الأيسر خارج المنتجات لكن في نفس المستوى -->
        <button class="scroll-button scroll-left btn btn-dark">
            <i class="bi bi-chevron-left"></i>
        </button>

        <!-- ✅ زر السهم الأيمن خارج المنتجات -->
        <button class="scroll-button scroll-right btn btn-dark">
            <i class="bi bi-chevron-right"></i>
        </button>

        <div class="overflow-hidden px-5">
            <!-- padding to create space -->
            <div class="product-slider d-flex" id="productSlider">
                @foreach (var item in Model.Items)
                {
                    <div class="card product-card">
                        <a asp-action="Index" asp-controller="ProduectDetails" asp-route-productId="@item.Id" class="text-decoration-none text-dark">
                            <img src="~/images/@item.HeaderImage" class="card-img-top" alt="@item.Name" />
                            <div class="card-body text-center">
                                <h6 class="card-title text-truncate">@item.Name</h6>
                                <p class="text-info fw-semibold mb-2">@item.Price EGP</p>
                                <div class="text-warning small mb-2">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i><i class="bi bi-star"></i>
                                </div>
                                <a asp-action="Product" asp-controller="Product" asp-route-productId="@item.Id" class="btn custom-signin-btn w-100">
                                    Buy Now
                                </a>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>

    <br />

    <br />
    <div class="d-flex justify-content-center">
        <div class="row justify-content-center">
            @foreach (var item in Model.Items)
            {
                <div class="col-sm-6 col-md-4 col-lg-3 mb-4 d-flex">
                    <div class="card product-card h-100 text-center w-100">
                        <a asp-action="Product" asp-controller="Product" asp-route-productId="@item.Id" class="text-decoration-none text-dark">
                            <img src="~/images/@item.HeaderImage" class="card-img-top" alt="@item.Name" />
                            <div class="card-body">
                                <h6 class="card-title text-truncate">@item.Name</h6>
                                <p class="text-info fw-semibold mb-2">@item.Price EGP</p>
                                <div class="text-warning small mb-2">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i><i class="bi bi-star"></i>
                                </div>
                                <a asp-action="Product" asp-controller="Product" asp-route-productId="@item.Id" class="btn custom-signin-btn w-100">
                                    Buy Now
                                </a>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <br />
    <br />
    <br />
    <br />
    <br />
    <br />

    @* <nav aria-label="Page navigation example">
			<ul class="pagination justify-content-center">
				<li class="page-item">
					<a class="page-link" href="#" aria-label="Previous">
						<span aria-hidden="true">&laquo;</span>
					</a>
				</li>
				@for (var i = 1; i <= Model.TotalPages; i++)
				{
					<li class="page-item"><a class="page-link" asp-action="Index" asp-route-index="@i" asp-route-size="10">@i</a></li>
				}
				<li class="page-item">
					<a class="page-link" href="#" aria-label="Next">
						<span aria-hidden="true">&raquo;</span>
					</a>
				</li>
			</ul>
		</nav> *@



    <!-- روابط السوشيال ميديا -->
    <div class="text-center mt-5">
        <div class="text-center mb-5">
            @* <h2 class="fw-bold text-dark">Welcome to Mobile Phones Store</h2> *@
            <h2 class="text-center mb-5 fw-bold">
                <span class="bg-black text-white px-3 py-2 rounded">
                    🔗 Follow us on social media
                </span>
            </h2>

        </div>


        <div class="d-flex justify-content-center gap-4 fs-3">


            <a href="https://www.facebook.com/YourPage" target="_blank" class="text-primary">
                <i class="bi bi-facebook text-primary"></i>
            </a>

            <a href="https://www.instagram.com/YourPage" target="_blank" class="text-danger">
                <i class="bi bi-instagram text-danger"></i>
            </a>

            <a href="https://twitter.com/YourPage" target="_blank" class="text-info">
                <i class="bi bi-twitter text-info"></i>
            </a>

            <a href="https://www.linkedin.com/company/YourCompany" target="_blank" class="text-primary">
                <i class="bi bi-linkedin text-primary"></i>
            </a>

            <a href="#" target="_blank" class="text-danger">
                <i class="bi bi-youtube text-danger"></i>
            </a>

            <a href="https://wa.me/201001234567" target="_blank" class="text-success">
                <i class="bi bi-whatsapp text-success"></i>
            </a>


        </div>
    </div>


</main>

<script>
    const slider = document.getElementById('productSlider');
    const scrollLeftBtn = document.querySelector('.scroll-left');
    const scrollRightBtn = document.querySelector('.scroll-right');

    scrollLeftBtn.addEventListener('click', () => {
        slider.scrollBy({
            left: -300,
            behavior: 'smooth'
        });
    });

    scrollRightBtn.addEventListener('click', () => {
        slider.scrollBy({
            left: 300,
            behavior: 'smooth'
        });
    });
</script>
