@model PaginationResult<ProductViewModel>

@{
    ViewData["Title"] = "Product";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<style>
    /* =========================
                Offers Products
                ========================= */

    .offers-products {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .offer-product {
        width: 250px;
        flex: 0 0 250px;
    }

        .offer-product .product-card {
            width: 250px;
            height: 100%;
            transition: transform 0.3s;
        }

            .offer-product .product-card:hover {
                transform: translateY(-5px);
            }

        /* Product image */
        .offer-product .card-img-top {
            width: 100%;
            height: 180px;
            object-fit: contain;
            display: block;
        }
</style>


<div class="container my-5">

    <!-- =========================
         Special Offers Title
         ========================= -->

    <h2 class="fw-bold text-center text-primary mb-5">
        🔥 Special Offers 🔥
    </h2>


    <!-- =========================
         Offers Products
         ========================= -->

    <div class="offers-products">

        @if (Model != null && Model.Items != null)
        {
            @foreach (var item in Model.Items)
            {
                <div class="offer-product">

                    <div class="card product-card shadow-sm h-100">

                        <a asp-action="Index"
                           asp-controller="ProduectDetails"
                           asp-route-productId="@item.Id"
                           class="text-decoration-none text-dark">

                            <!-- Product Image -->

                            <img src="~/images/@item.HeaderImage"
                                 class="card-img-top"
                                 alt="@item.Name" />


                            <!-- Product Information -->

                            <div class="card-body text-center">

                                <h6 class="card-title text-truncate fw-bold">
                                    @item.Name
                                </h6>


                                <!-- Old Price + Discount Price -->

                                <p class="mb-2">

                                    <span class="text-muted text-decoration-line-through me-2">
                                        @item.Price EGP
                                    </span>

                                    <span class="fw-bold text-danger fs-5">
                                        @item.DiscountPrice EGP
                                    </span>

                                </p>


                                <!-- Rating -->

                                <div class="text-warning small mb-3">

                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i>
                                    <i class="bi bi-star"></i>

                                </div>


                                <!-- Buy Button -->

                                <a asp-action="Product"
                                   asp-controller="Product"
                                   asp-route-productId="@item.Id"
                                   class="btn custom-signin-btn w-100">

                                    Buy Now

                                </a>

                            </div>

                        </a>

                    </div>

                </div>
            }
        }

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
