@model PurchaseProductViewModel
@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_MyLayout.cshtml";

    // جلب قيم التقييمات بطريقة آمنة سواء كانت مرسلة عبر الـ ViewBag أو الـ Model
    var avgRating = ViewBag.AverageRating != null ? Convert.ToDouble(ViewBag.AverageRating) : 0.0;
    var totalReviews = ViewBag.TotalRatings != null ? Convert.ToInt32(ViewBag.TotalRatings) : 0;
    var productReviews = ViewBag.Reviews as List<Products.Models.Review> ?? new List<Products.Models.Review>();
}

<div class="row justify-content-center align-items-start p-5">

    <div class="col-md-6 p-4 border-end border-2">
        <div class="card border-0">
            <!-- قسم الصور (Carousel) -->
            <div id="carouselExample" class="carousel slide">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/images/@Model.Product.HeaderImage" class="d-block w-100" height="500px" alt="Header Image" style="object-fit: cover;">
                    </div>
                    @if (Model.Product.Images != null)
                    {
                        @foreach (var img in Model.Product.Images)
                        {
                            <div class="carousel-item">
                                <img src="~/images/@img" class="d-block w-100" height="500px" alt="Product Image" style="object-fit: cover;">
                            </div>
                        }
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>

            <div class="card-body mt-5">
                <h5 class="card-title fw-bold">@Model.Product.Name</h5>
                <h5 class="card-title fw-bold text-muted">Smart Phone</h5>

                <h5 class="card-text fw-bold">@Model.Product.Description</h5>

                @if (Model.Product.HasOffer && Model.Product.DiscountPrice.HasValue)
                {
                    <h5 class="fw-bold text-danger">
                        <span class="text-decoration-line-through text-secondary me-3">@Model.Product.Price EGP</span>
                        <span class="fs-4">@Model.Product.DiscountPrice.Value EGP</span>
                    </h5>
                    <span class="badge bg-success fs-6 mb-3">🔥 عرض خاص</span>
                }
                else
                {
                    <h5 class="card-text fw-bold">@Model.Product.Price EGP</h5>
                }

                <!-- قسم عرض النجوم ومتوسط التقييمات -->
                <div class="rating-section my-3">
                    <div class="d-flex align-items-center">
                        <h4 class="me-2 mb-0 text-dark">@avgRating.ToString("0.0")</h4>
                        <div class="text-warning fs-4">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(avgRating))
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span>☆</span>
                                }
                            }
                        </div>
                        <span class="text-muted ms-2">(@totalReviews global ratings)</span>
                    </div>
                </div>

                <!-- المواصفات -->
                <h5 class="card-text fw-bold border-bottom pb-3 mt-4">Specifications : </h5>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Brand : </span>@Model.Product.Brand</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Model : </span>@Model.Product.Name</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Storage : </span>@Model.Product.Storage</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Color : </span>@Model.Product.Colors</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Display : </span>@Model.Product.Display</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Processor : </span>@Model.Product.Processor</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">RAM : </span>@Model.Product.Ram</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Camera : </span>@Model.Product.Camera</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Battery : </span>@Model.Product.Battery</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">OS : </span>@Model.Product.Os</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Weight : </span>@Model.Product.Weight</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Dimensions : </span>@Model.Product.Dimensions</h6>
                <h6 class="my-3"><span class="fw-bold text-info fs-5 me-5 ">Sold Item : </span>@Model.Product.NumOfSoldItems</h6>

                <a asp-action="Product" asp-controller="Product" asp-route-productId="@Model.Product.Id" class="btn btn-dark w-100 mb-4 mt-3">Buy Now</a>

                <!-- عرض قائمة التعليقات السابقة إن وجدت -->
                @if (productReviews != null && productReviews.Any())
                {
                    <div class="mt-4 mb-4">
                        <h4 class="mb-3">Customer Reviews</h4>
                        @foreach (var review in productReviews)
                                        
                    {
                    <div class="card p-3 mb-2 bg-white border-0 shadow-sm">
                        <div class="d-flex justify-content-between">
                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                    {
                                        <span>@(i <= review.Rating ? "★" : "☆")</span>
                                    }
                                </div>
                                <small class="text-muted">@review.CreatedAt.ToString("yyyy-MM-dd")</small>
                            </div>
                            <p class="mb-0 mt-2 text-dark">@review.Comment</p>
                        </div>
                        }
                    </div>
                }

                <!-- نموذج إضافة تقييم تفاعلي (يظهر للمسجلين فقط) -->
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="card mt-4 p-4 shadow-sm bg-light border-0">
                        <h4 class="mb-3">Rate this Product</h4>
                        <form asp-controller="ProduectDetails" asp-action="AddReview" method="post">
                            <input type="hidden" name="productId" value="@Model.Product.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-bold d-block">Select Stars:</label>
                                <!-- النجوم التفاعلية -->
                                <div class="rating-stars fs-3 text-warning" style="cursor: pointer;">
                                    <span data-value="1" style="color: #ffc107;">★</span>
                                    <span data-value="2" style="color: #ffc107;">★</span>
                                    <span data-value="3" style="color: #ffc107;">★</span>
                                    <span data-value="4" style="color: #ffc107;">★</span>
                                    <span data-value="5" style="color: #ffc107;">★</span>
                                </div>
                                <!-- حقل مخفي لتخزين عدد النجوم المُختار -->
                                <input type="hidden" name="rating" id="selectedRating" value="5" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Your Comment:</label>
                                <textarea name="comment" class="form-control" rows="3" placeholder="Write your feedback here..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Submit Review</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary mt-3 text-center">
                        Please <a asp-controller="Authentication" asp-action="SignIn">Sign In</a> to write a review.
                    </div>
                }

            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- جافاسكريبت تفاعلي للتحكم في النجوم -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stars = document.querySelectorAll('.rating-stars span');
            const ratingInput = document.getElementById('selectedRating');

            if (stars.length > 0 && ratingInput) {
                stars.forEach((star) => {
                    star.addEventListener('click', () => {
                        const ratingValue = star.getAttribute('data-value');
                        ratingInput.value = ratingValue;

                        // تلوين النجوم عند النقر
                        stars.forEach((s, i) => {
                            if (i < ratingValue) {
                                s.style.color = '#ffc107'; // أصفر
                            } else {
                                s.style.color = '#e4e5e9'; // رمادي باهت
                            }
                        });
                    });
                });
            }
        });
    </script>
}