@model List<Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2>All Products</h2>
<table class="table table-bordered">
    <thead>
        <tr><th>Name</th><th>Price</th><th>Saller</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>@p.Seller.UserName</td>
            </tr>
        }
    </tbody>
</table>