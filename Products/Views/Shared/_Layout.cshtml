@using System.Security.Claims
@using Products.Infrastructure

@{
    Layout = null;
    @inject IHttpContextAccessor _httpContextAccessor;





    var user = _httpContextAccessor.HttpContext.User;
    var isAuthenticated = user.Identity.IsAuthenticated;
    var userName = user.FindFirstValue(ClaimTypes.Name);
    string? profilePhoto = "/images/userprofile/profileuser.png";

    if (isAuthenticated)
    {
        var userId = int.Parse(user.FindFirstValue(ClaimTypes.NameIdentifier));

        // Get photo path from DB
        using (var scope = _httpContextAccessor.HttpContext.RequestServices.CreateScope())
        {
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationContext>();
            var appUser = dbContext.Users.FirstOrDefault(u => u.Id == userId);
            profilePhoto = appUser?.PhotoPath ?? "/images/userprofile/profileuser.png";
        }
    }

    var userRole = "";

    if (isAuthenticated)
    {
        using (var scope = _httpContextAccessor.HttpContext.RequestServices.CreateScope())
        {
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationContext>();
            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            var userRoles = (from ur in dbContext.UserRoles
                             join r in dbContext.Roles on ur.RoleId equals r.Id
                             where ur.UserId == int.Parse(userId)
                             select r.Name).ToList();

            userRole = userRoles.FirstOrDefault(); // اختر أول دور فقط


        }
    }
    var isSaller = user.IsInRole(userRole); // يتحقق من الدور
    var isBuyer = user.IsInRole(userRole); // يتحقق من الدور
    var isAdmin = user.IsInRole(userRole); // يتحقق من الدور


}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] -  Phones Store</title>
    <link href="~/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Products.styles.css" asp-append-version="true" />
    <style>
        h1, h2, h3, h4, h5 {
            font-weight: 700;
        }

        .nav-link:hover {
            color: #ffc107 !important; /* Yellow text on hover */
        }

        .btn {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        p, label, input, textarea {
            font-size: 1.05rem;
        }

        .custom-signin-btn {
            background-color: #212529; /* نفس لون btn-dark */
            color: white;
            border: none;
            transition: background-color 0.3s ease;
        }

            .custom-signin-btn:hover {
                background-color: #0d6efd; /* Bootstrap primary blue */
                color: white;
            }
    </style>

</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Header Top Bar -->
    <!-- Header: Title and Navbar in same div -->
    <header class="text-white py-3" style="background-color: #87CEEB; border-top: 3px solid #003366; border-bottom: 3px solid #003366;">
        <div class="container">
            <div class="row align-items-center text-center">

                <!-- العمود الأول: فارغ أو تستخدمه مستقبلاً -->
                <div class="col-4">
                    <div class="fs-3 fw-bold d-flex justify-content-center align-items-center">
                        <span class="me-2">📱</span> Phones Store
                    </div>
                </div>

                <!-- العمود الثاني: اللوجو والعنوان في المنتصف -->
                <div class="col-6">
                    <nav class="navbar navbar-expand-lg">
                        <div class="container-fluid justify-content-center">
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <div class="collapse navbar-collapse" id="navbarNav">
                                <ul class="navbar-nav">
                                    <li class="nav-item">
                                        <a class="nav-link text-white fw-bold mx-2" href="/Home/Index">Home</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white fw-bold mx-2" href="/About/Index">About</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white fw-bold mx-2" href="/offers/Index">Today's Deals</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white fw-bold mx-2" href="/ContactUs/Index">Contact</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white fw-bold mx-2" href="/Home/FeedBack">Feedback</a>
                                    </li>
                                    @if (isAuthenticated && userRole == "Saller")
                                    {
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle text-white fw-bold mx-2 d-flex align-items-center"
                                               href="#" id="buyerDropdown" role="button" data-bs-toggle="dropdown">
                                                <img src="@profilePhoto" class="rounded-circle me-2" width="32" height="32" />
                                                @_httpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name)
                                            </a>
                                            <ul class="dropdown-menu text-start" aria-labelledby="buyerDropdown">
                                                <li><a class="dropdown-item" href="/Saller/Index">Deshborad</a></li>

                                            </ul>
                                        </li>
                                    }
                                    else if (isAuthenticated && userRole == "Buyer")
                                    {
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle text-white fw-bold mx-2 d-flex align-items-center"
                                               href="#" id="buyerDropdown" role="button" data-bs-toggle="dropdown">
                                                <img src="@profilePhoto" class="rounded-circle me-2" width="32" height="32" />
                                                @_httpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name)
                                            </a>
                                            <ul class="dropdown-menu text-start" aria-labelledby="buyerDropdown">
                                                <li><a class="dropdown-item" href="/Buyer/Dashboard">Deshborad</a></li>

                                            </ul>
                                        </li>
                                    }
                                    else if (isAuthenticated && userRole == "Admin")
                                    {
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle text-white fw-bold mx-2 d-flex align-items-center"
                                               href="#" id="buyerDropdown" role="button" data-bs-toggle="dropdown">
                                                <img src="@profilePhoto" class="rounded-circle me-2" width="32" height="32" />
                                                @_httpContextAccessor.HttpContext?.User?.FindFirstValue(ClaimTypes.Name)
                                            </a>
                                            <ul class="dropdown-menu text-start" aria-labelledby="buyerDropdown">
                                                <li><a class="dropdown-item" href="/Admin/Dashboard">Deshborad</a></li>
                                            </ul>
                                        </li>
                                    }
                                    else if (!isAuthenticated)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link text-white fw-bold mx-2" href="/Authentication/SignIn">Login</a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                    </nav>


                </div>

                <!-- العمود الثالث: المينيو في المنتصف داخل العمود -->
                <div class="col-2">
                </div>

            </div>
        </div>
    </header>


    <!-- Main Content -->
    <main role="main" class="my-5 px-3">

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-white mt-auto"
            style="display: flex; align-items: center; background-color: #87CEEB; justify-content: center; height: 88px; font-weight: 700; text-align: center; border-top: 3px solid #003366; border-bottom: 3px solid #003366;">
        <b>© 2025 Phones Store. All rights reserved.</b>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>